[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="1"]
resource_name = "StarRating"
script/source = "extends Control
class_name StarRating

signal animation_finished

@export var star_size: int = 64
@export var star_spacing: int = 10
@export var filled_color: Color = Color(1.0, 0.84, 0.0)  # Gold
@export var empty_color: Color = Color(0.3, 0.3, 0.3)    # Dark gray
@export var animation_delay: float = 0.1  # Delay between each star

var rating: int = 0
var max_stars: int = 3
var stars: Array[Label] = []
var is_animating: bool = false

func _ready():
	custom_minimum_size = Vector2(star_size * max_stars + star_spacing * (max_stars - 1), star_size)
	setup_stars()

func setup_stars():
	# Clear existing stars
	for child in get_children():
		child.queue_free()
	stars.clear()
	
	# Create star labels
	for i in max_stars:
		var star = Label.new()
		star.text = \"★\"
		star.add_theme_font_size_override(\"font_size\", star_size)
		star.add_theme_color_override(\"font_color\", empty_color)
		star.position = Vector2(i * (star_size + star_spacing), 0)
		star.pivot_offset = Vector2(star_size / 2, star_size / 2)
		add_child(star)
		stars.append(star)

func set_rating(value: int, animate: bool = false):
	rating = clampi(value, 0, max_stars)
	
	if animate and not is_animating:
		animate_stars()
	else:
		# Instant update
		for i in stars.size():
			if i < rating:
				stars[i].add_theme_color_override(\"font_color\", filled_color)
				stars[i].scale = Vector2.ONE
			else:
				stars[i].add_theme_color_override(\"font_color\", empty_color)
				stars[i].scale = Vector2.ONE

func animate_stars():
	is_animating = true
	
	# Reset all stars first
	for star in stars:
		star.add_theme_color_override(\"font_color\", empty_color)
		star.scale = Vector2.ZERO
	
	# Animate each star that should be filled
	for i in rating:
		await get_tree().create_timer(animation_delay * i).timeout
		
		var star = stars[i]
		var tween = create_tween()
		tween.set_ease(Tween.EASE_OUT)
		tween.set_trans(Tween.TRANS_BACK)
		
		# Scale up with overshoot
		tween.tween_property(star, \"scale\", Vector2(1.3, 1.3), 0.15)
		tween.parallel().tween_property(star, \"rotation\", deg_to_rad(360), 0.15)
		tween.tween_property(star, \"scale\", Vector2.ONE, 0.1)
		
		# Color change
		star.add_theme_color_override(\"font_color\", filled_color)
		
		# Play a sound here if needed
	
	# Wait for last animation to finish
	await get_tree().create_timer(animation_delay * rating + 0.25).timeout
	is_animating = false
	emit_signal(\"animation_finished\")
"

[node name="StarRating" type="Control"]
custom_minimum_size = Vector2(212, 64)
script = SubResource("1")